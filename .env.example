# Supabase (backup target only — used by nightly dump script, not by app)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Local PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:your-password@localhost:5432/wes_vendor
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wes_vendor
DB_USER=postgres
DB_PASSWORD=your-password

# PgBouncer (connection pooler — optional, only for multi-worker deployments)
PGBOUNCER_HOST=localhost
PGBOUNCER_PORT=6432
PGBOUNCER_POOL_SIZE=10

# File Uploads (local filesystem)
UPLOAD_DIR=/var/wes-vendor/uploads
APP_URL=http://localhost:8000

# Resend (email)
RESEND_API_KEY=re_xxxxxxxxx
MAIL_FROM=onboarding@resend.dev
# DEFAULT_CC=mahmudtarek1971@gmail.com # MD email for production/demo
DEFAULT_CC=muhtasimhossain43@gmail.com

# App
SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=true